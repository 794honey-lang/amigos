datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  phone         String?  @unique             // optional mobile number, must be unique if set
  email         String?  @unique            // optional email, unique
  password      String                     // plain text for dev, hash in prod
  name          String
  role          String   // "corporate", "franchise", "store", "customer"
  storeId       String?  // set for store managers
  franchiseId   String?  // set for franchise owners
  addresses     Json     @default("[]")   // array of address objects
  favourites    Json     @default("[]")   // array of menu item IDs
  walletBalance Float    @default(0)
  disabled      Boolean  @default(false)    // disable/enable user login
  isSuperAdmin  Boolean  @default(false)    // super admin vs acting admin flag
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  loginEvents   LoginEvent[]
  orders        Order[]
}


model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?  // null for failed logins (unknown user)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String   // The email/phone attempted
  success   Boolean  // true = successful login, false = failed attempt
  ip        String?  // Client IP address
  userAgent String?  // Browser/device string
  role      String?  // Role of user if login succeeded
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id
  name      String
  icon      String
  menuItems MenuItem[]
}

model MenuItem {
  id            String             @id
  name          String
  category      String
  categoryRef   Category           @relation(fields: [category], references: [id])
  isVeg         Boolean
  description   String
  image         String
  basePrice     Float
  prices        Json               // Stores sizes config e.g. { "regular": 290, "medium": 490 }
  rating        Float              @default(4.5)
  reviews       Int                @default(1)
  isBestseller  Boolean            @default(false)
  customizable  Boolean            @default(false)
  availabilities StoreAvailability[]
}

model StoreAvailability {
  id            String   @id @default(uuid())
  storeId       String
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  available     Boolean  @default(true)
  priceOverride Float?

  @@unique([storeId, menuItemId])
}

model Banner {
  id       Int    @id @default(autoincrement())
  title    String
  subtitle String
  code     String?
  bg       String
  image    String
}

model Promotion {
  code           String   @id
  title          String
  description    String
  discountType   String   // "percentage" or "flat"
  discountValue  Float
  minOrderValue  Float
  maxDiscount    Float
  startDate      String
  endDate        String
  scopeType      String   // "national", "regional", "store"
  scopeId        String?
  isActive       Boolean  @default(true)
}

model Order {
  id            String      @id // Custom ID e.g., "A1001"
  storeId       String?
  storeName     String?
  driverName    String?
  date          String      // Stored as string to preserve UI display format or timestamp
  status        String      // "Placed", "Confirmed", "Preparing", "Ready", "OutForDelivery", "Delivered"
  itemTotal     Float
  deliveryFee   Float
  taxes         Float
  discount      Float
  toPay         Float
  paymentMethod String      @default("UPI")
  address       Json
  customer      Json        // { name, phone }
  items         Json        // JSON list of ordered items (with sizes, crusts, toppings)
  userId        String?     // reference to User.id
  user          User?       @relation(fields: [userId], references: [id])
}

model PromoOverride {
  id        String   @id @default(uuid())
  storeId   String
  promoCode String
  enabled   Boolean  @default(true)

  @@unique([storeId, promoCode])
}

model Franchise {
  id        String   @id
  name      String
  district  String
  ownerName String
  email     String
  phone     String
  address   String
  stores    Store[]
}

model Store {
  id          String    @id
  franchiseId String
  franchise   Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  name        String
  city        String
  address     String
  lat         Float
  lng         Float
  status      String    // "Open", "Paused", "Closed"
  managerName String
  phone       String
  createdAt   DateTime  @default(now())
  deliveryZone Json     @default("{}") // Delivery zone config for the store
}
